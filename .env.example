PORT=4000
DATA_DIR=
CORS_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
HTTP_RETRY_COUNT=2

# NASA EONET v3 (Earth natural events — not Mars)
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
EONET_TIMEOUT_MS=10000
EONET_CACHE_TTL_SEC=120
EONET_DEFAULT_STATUS=open
EONET_DEFAULT_LIMIT=50
EONET_DEFAULT_DAYS=30

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
OBSERVABILITY_BACKEND=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mars-explorer
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
NASA_API_KEY=DEMO_KEY
DATABASE_URL=postgresql://mars:mars@localhost:5432/mars_explorer

# Web browser key: put in apps/web/.env.local for Next.js
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=
# Optional seeded Jezero spatial profile; run data/jezero/postgis/001_seed.sql first
POSTGIS_ENABLED=false

# RAG + mission agent (optional). Gemini is primary; Claude is the fallback.
# RAG_ADMIN_TOKEN=change-me
# RAG_GEMINI_MODEL=gemini-2.5-flash
# RAG_CLAUDE_MODEL=claude-opus-5-5
# RAG_EMBED_MODEL=gemini-embedding-001
# TypeSafe Jev "System One" router for the agent fast mode (Cloudflare Workers AI). Without these, rules route.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# JEV_MODEL=typesafe/jev
